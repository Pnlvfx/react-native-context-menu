{
  "name": "@simonegauli/react-native-context-menu",
  "version": "0.5.0",
  "description": "Native context menus for React Native — built on Fabric with a composable slot-based API",
  "keywords": [
    "react-native",
    "ios",
    "android",
    "context-menu",
    "long-press",
    "press-and-hold",
    "native-menu",
    "popup-menu",
    "fabric",
    "new-architecture",
    "UIContextMenuInteraction",
    "sf-symbols",
    "composable",
    "slot-based",
    "typescript",
    "react-native-new-architecture",
    "3d-touch",
    "haptic",
    "menu-actions",
    "destructive-action"
  ],
  "homepage": "https://github.com/Pnlvfx/react-native-context-menu#readme",
  "bugs": {
    "url": "https://github.com/Pnlvfx/react-native-context-menu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pnlvfx/react-native-context-menu.git"
  },
  "license": "MIT",
  "author": "Simone Gauli <simonegauli@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "workspaces": [
    "example"
  ],
  "scripts": {
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "example": "yarn workspace react-native-context-menu-example",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "maestro": "node tools/maestro.ts",
    "prepack": "bob build",
    "prepare": "bob build",
    "release": "node tools/release.ts",
    "showcase": "node tools/showcase.ts",
    "test": "jest",
    "update": "yarn upgrade-interactive"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "dependencies": {
    "sf-symbols-typescript": "^2.2.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/config-helpers": "^0.7.0",
    "@goatjs/react-native-eslint": "^3.21.0",
    "@goatjs/typescript-config": "^2.2.0",
    "@jest/globals": "^30.4.1",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@types/react": "^19.2.18",
    "babel-plugin-react-compiler": "0.0.0-experimental-a1856f3-20260507",
    "commitlint": "^21.2.2",
    "del-cli": "^7.0.0",
    "eslint": "^10.8.1",
    "execa": "^10.0.1",
    "jest": "^30.4.2",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-builder-bob": "^0.43.0",
    "turbo": "^2.10.9",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": "*"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "codegenConfig": {
    "name": "ContextMenuViewSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.contextmenu"
    },
    "ios": {
      "components": {
        "ContextMenuView": {
          "className": "ContextMenuView"
        }
      }
    }
  },
  "create-react-native-library": {
    "type": "fabric-view",
    "languages": "kotlin-objc",
    "tools": [
      "eslint",
      "jest",
      "lefthook"
    ],
    "version": "0.62.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true,
          "configFile": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
